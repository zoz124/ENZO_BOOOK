@{
    var code = ViewData["StatusCode"] as int? ?? 404;

    var (title, message) = code switch
    {
        403 => ("You cannot open this page", "This page is restricted. If that seems wrong, head back to the store or contact support."),
        500 => ("Something went wrong", "Try refreshing the page. If it keeps happening, our team is already looking at the logs."),
        _ => ("Page not found", "The link may be old or the book was removed. Try searching from the home page.")
    };

    ViewData["Title"] = code.ToString();
}

<div class="container">
    <section class="empty-state" style="margin-block: var(--space-12) var(--space-24)">
        <span class="eyebrow">@code</span>
        <h2>@title</h2>
        <p>@message</p>
        <p>
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the store</a>
            <a class="btn btn-secondary" asp-controller="Books" asp-action="Index">Browse books</a>
        </p>
    </section>
</div>
