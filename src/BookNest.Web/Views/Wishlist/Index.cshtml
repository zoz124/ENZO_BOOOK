@model IReadOnlyList<WishlistItemDto>

@{
    ViewData["Title"] = "Wishlist";
}

<div class="container">
    <div style="padding-block: var(--space-12) var(--space-8)">
        <span class="eyebrow">Saved for later</span>
        <h1 style="font-size: clamp(1.9rem, 3.4vw, 2.6rem)">Wishlist</h1>
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state" style="margin-block-end: var(--space-24)">
            <h2>Your wishlist is empty</h2>
            <p>Tap the heart on any book you love.</p>
            <a class="btn btn-primary" asp-controller="Books" asp-action="Index">Browse books</a>
        </div>
    }
    else
    {
        <div class="table-wrapper" style="margin-block-end: var(--space-24)">
            <table class="table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Author</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId">@item.Title</a></td>
                            <td>@item.AuthorName</td>
                            <td>EGP @item.EffectivePrice.ToString("N2")</td>
                            <td>@(item.Stock > 0 ? "In stock" : "Sold out")</td>
                            <td>
                                <form method="post" asp-controller="Wishlist" asp-action="Remove" class="inline-form">
                                    <input type="hidden" name="bookId" value="@item.BookId" />
                                    <button class="link-button" type="submit">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
