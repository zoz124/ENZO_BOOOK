@model LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<span class="eyebrow">Welcome to Enzo</span>
<h1 class="auth-title">Welcome back.</h1>
<p class="auth-subtitle">Sign in to view your library, wishlist and orders.</p>

<partial name="_AuthTabs" model="@("login")" />

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-error auth-alert" role="alert"></div>
}

<form method="post" asp-controller="Account" asp-action="Login" class="auth-form">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="field">
        <label asp-for="Email">Email address</label>
        <input class="input" asp-for="Email" type="email" autocomplete="username" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Password">Password</label>
        <input class="input" asp-for="Password" type="password" autocomplete="current-password" placeholder="At least 8 characters" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="auth-row">
        <label class="auth-check">
            <input asp-for="RememberMe" />
            Remember me
        </label>

        <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">Forgot password?</a>
    </div>

    <button class="btn btn-primary auth-submit" type="submit">
        Sign in
        <span aria-hidden="true">→</span>
    </button>
</form>

<div class="auth-divider"><span>or continue with</span></div>

<button class="auth-google" type="button" disabled aria-disabled="true" title="Google sign-in is coming soon">
    <svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-2.8-.4-4.1H24v7.7h12.1c-.2 2-1.6 5-4.5 7l-.1.1 6.6 5.1.5.1c4.2-3.9 6.5-9.6 6.5-15.9Z" />
        <path fill="#34A853" d="M24 46c6 0 11-2 14.6-5.4l-7-5.4c-1.9 1.3-4.4 2.2-7.6 2.2-5.8 0-10.7-3.8-12.5-9l-.1.1-6.8 5.3-.1.2C8 41.4 15.4 46 24 46Z" />
        <path fill="#FBBC05" d="M11.5 28.4A13.7 13.7 0 0 1 10.8 24c0-1.5.3-3 .7-4.4l-.1-.2-6.9-5.3-.2.1A22 22 0 0 0 2 24c0 3.5.8 6.9 2.3 9.8l7.2-5.4Z" />
        <path fill="#EA4335" d="M24 10.1c4 0 6.8 1.8 8.4 3.3l6.1-6C34.8 4.1 30 2 24 2 15.4 2 8 6.6 4.3 14.2l7.2 5.4C13.3 13.9 18.2 10.1 24 10.1Z" />
    </svg>
    Google
</button>

<p class="auth-legal">
    By continuing, you agree to Enzo's <span>Terms of Service</span> and <span>Privacy Policy</span>.
</p>

@section Scripts {
    <script src="~/js/app.js" asp-append-version="true"></script>
}
