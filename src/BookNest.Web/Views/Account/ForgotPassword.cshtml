@model ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<span class="eyebrow">Account help</span>
<h1 class="auth-title">Reset your password.</h1>
<p class="auth-subtitle">Enter your email and we will send you a link to set a new one.</p>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
}

@if (TempData["ResetLink"] is string resetLink)
{
    <div class="alert alert-warning">
        Email delivery is not enabled yet, so here is the reset link directly:
        <a href="@resetLink">Reset password</a>
    </div>
}

<form method="post" asp-controller="Account" asp-action="ForgotPassword" class="auth-form">
    <div class="field">
        <label asp-for="Email">Email address</label>
        <input class="input" asp-for="Email" type="email" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <button class="btn btn-primary auth-submit" type="submit">
        Send reset link
        <span aria-hidden="true">→</span>
    </button>
</form>

<p class="auth-legal">
    <a asp-controller="Account" asp-action="Login">Back to sign in</a>
</p>
