@model ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Set a new password";
}

<span class="eyebrow">Account help</span>
<h1 class="auth-title">Set a new password.</h1>
<p class="auth-subtitle">Choose a password you have not used before.</p>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-error" role="alert"></div>
}

<form method="post" asp-controller="Account" asp-action="ResetPassword" class="auth-form">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />

    <div class="field">
        <label asp-for="Password">New password</label>
        <input class="input" asp-for="Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword">Confirm password</label>
        <input class="input" asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button class="btn btn-primary auth-submit" type="submit">
        Save password
        <span aria-hidden="true">→</span>
    </button>
</form>
