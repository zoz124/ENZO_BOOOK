@model DashboardStatsDto

@{
    ViewData["Title"] = "Dashboard";
    var max = Model.SalesLast30Days.Count > 0 ? Model.SalesLast30Days.Max(d => d.Total) : 1m;
    if (max <= 0) { max = 1m; }
    var hasTrend = Model.SalesLast30Days.Count > 1;
    var singleDay = Model.SalesLast30Days.Count == 1 ? Model.SalesLast30Days[0] : null;
    var firstDay = Model.SalesLast30Days.FirstOrDefault();
    var lastDay = Model.SalesLast30Days.LastOrDefault();
    var topRevenue = Model.TopBooks.Count > 0 ? Model.TopBooks.Max(b => b.Revenue) : 1m;
    if (topRevenue <= 0) { topRevenue = 1m; }
    var pending = Model.NewOrders;
    var lowStock = Model.LowStockBooks.Count;
    var outOfStock = Model.OutOfStockCount;
    var noReviews = Model.ReviewsCount == 0;
}

<div class="admin-page-head admin-page-head--dashboard">
    <div>
        <p class="admin-eyebrow">Store performance</p>
        <h1>The month at a glance</h1>
        <p class="admin-page-sub">Sales, orders, stock health and reader feedback for the last 30 days.</p>
    </div>

    <div class="admin-head-meta">
        <span class="admin-date">@DateTime.Now.ToString("ddd, dd MMM yyyy")</span>
        <a class="btn btn-primary btn-sm" asp-area="" asp-controller="Home" asp-action="Index">
            View storefront
            <span aria-hidden="true">↗</span>
        </a>
    </div>
</div>

<div class="stat-grid">
    <div class="stat-card stat-card--primary">
        <p class="stat-label">Total sales</p>
        <p class="stat-value">EGP @Model.TotalSales.ToString("N0")</p>
        <p class="stat-foot">Excluding cancelled orders</p>
    </div>

    <a class="stat-card @(pending > 0 ? "stat-card--alert" : null)"
       asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Pending"
       aria-label="Review @pending pending orders">
        <p class="stat-label">Orders</p>
        <p class="stat-value">@Model.OrdersCount</p>
        <p class="stat-foot">@pending pending review</p>
    </a>

    <a class="stat-card @(lowStock > 0 ? "stat-card--alert" : null)"
       asp-area="Admin" asp-controller="Books" asp-action="Index" asp-route-lowStock="true"
       aria-label="Open the low stock shelf">
        <p class="stat-label">Low stock titles</p>
        <p class="stat-value">@lowStock</p>
        <p class="stat-foot">10 copies or fewer</p>
    </a>

    <a class="stat-card @(outOfStock > 0 ? "stat-card--alert stat-card--danger" : null)"
       asp-area="Admin" asp-controller="Books" asp-action="Index" asp-route-lowStock="true"
       aria-label="Open titles that need a restock">
        <p class="stat-label">Out of stock</p>
        <p class="stat-value">@outOfStock</p>
        <p class="stat-foot">Titles unavailable now</p>
    </a>

    <div class="stat-card">
        <p class="stat-label">Reader ratings</p>
        @if (noReviews)
        {
            <p class="stat-value stat-value--text">No reviews yet</p>
            <p class="stat-foot">Awaiting reader notes</p>
        }
        else
        {
            <p class="stat-value">@Model.ReviewsCount</p>
            <p class="stat-foot">Average @Model.AverageRating.ToString("0.0") / 5</p>
        }
    </div>
</div>

<section class="admin-section">
    <div class="section-head">
        <div>
            <p class="eyebrow">Revenue</p>
            <div class="section-title-row">
                <h2>Sales, last 30 days</h2>
                @if (Model.SalesLast30Days.Count > 0)
                {
                    <span class="admin-peak">Peak day EGP @max.ToString("N0")</span>
                }
            </div>
        </div>
    </div>

    @if (Model.SalesLast30Days.Count == 0)
    {
        <div class="empty-state empty-state--admin">
            <span class="empty-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                    <path d="M4 19V5M4 19h16" />
                    <path d="m7 15 4-5 3 3 4-6" />
                </svg>
            </span>
            <p>No sales recorded in this period. The first order will start the chart.</p>
        </div>
    }
    else if (!hasTrend)
    {
        <div class="chart-empty">
            <span class="empty-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
                    <path d="M4 19V5M4 19h16" />
                    <path d="m7 15 4-5 3 3 4-6" />
                </svg>
            </span>
            <div class="chart-empty-copy">
                <strong>A trend needs more than a day</strong>
                <p>There is a single day of sales in this window, so there is no line to compare yet.</p>
            </div>
            <div class="chart-single">
                <span class="chart-single-value">EGP @(singleDay?.Total.ToString("N0") ?? "0")</span>
                <span class="chart-single-bar" aria-hidden="true"></span>
                <span class="chart-single-day">@singleDay?.Day.ToString("dd MMM")</span>
            </div>
        </div>
    }
    else
    {
        <div class="chart-bars">
            @foreach (var day in Model.SalesLast30Days)
            {
                var height = (int)Math.Round(day.Total / max * 100);
                <div class="chart-bar @(day.Total <= 0 ? "is-empty" : null)" style="height:@(Math.Max(height, 2))%" title="@day.Day.ToString("yyyy-MM-dd"): EGP @day.Total.ToString("N0")"></div>
            }
        </div>
        <div class="chart-foot">
            <span>@firstDay?.Day.ToString("dd MMM")</span>
            <span>@lastDay?.Day.ToString("dd MMM yyyy")</span>
        </div>
    }
</section>

<div class="admin-split">
    <section class="admin-section">
        <div class="section-head">
            <div>
                <p class="eyebrow">Catalogue</p>
                <h2>Top 10 books</h2>
            </div>
        </div>

        @if (Model.TopBooks.Count == 0)
        {
            <div class="empty-state empty-state--admin">
                <span class="empty-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 5h6a2 2 0 0 1 2 2v13a1.6 1.6 0 0 0-1.6-1.6H4Z" />
                        <path d="M20 5h-6a2 2 0 0 0-2 2v13a1.6 1.6 0 0 1 1.6-1.6H20Z" />
                    </svg>
                </span>
                <p>No sales yet — top sellers appear after the first order.</p>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="table top-books-table">
                    <thead>
                        <tr><th>#</th><th>Book</th><th class="num">Copies</th><th class="num">Revenue</th></tr>
                    </thead>
                    <tbody>
                        @{ var rank = 0; }
                        @foreach (var book in Model.TopBooks)
                        {
                            rank++;
                            <tr>
                                <td><span class="rank">@rank.ToString("00")</span></td>
                                <td class="top-book-title">
                                    @book.Title
                                    <span class="admin-bar" style="inline-size:@(Math.Round(book.Revenue / topRevenue * 100))%"></span>
                                </td>
                                <td class="num">@book.UnitsSold</td>
                                <td class="num">EGP @book.Revenue.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="section-head" style="margin-block-start: var(--space-8)">
            <div>
                <p class="eyebrow">Demand</p>
                <h2>Category mix</h2>
            </div>
        </div>

        @if (Model.CategorySales.Count == 0)
        {
            <div class="empty-state empty-state--admin">
                <span class="empty-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19V9M10 19V5M16 19v-7M22 19H2" />
                    </svg>
                </span>
                <p>No category demand yet. Sales will show which shelves move.</p>
            </div>
        }
        else
        {
            <div class="card">
                @foreach (var category in Model.CategorySales)
                {
                    <div class="summary-row">
                        <span>@category.CategoryName</span>
                        <span class="cart-line-meta">@category.UnitsSold copies · EGP @category.Revenue.ToString("N0")</span>
                    </div>
                }
            </div>
        }
    </section>

    <aside>
        <section>
            <div class="section-head"><h2 class="section-title-sm">Quick actions</h2></div>

            <div class="admin-actions">
                <a asp-area="Admin" asp-controller="Books" asp-action="Create">
                    <span>Add a new book</span><span aria-hidden="true">→</span>
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Pending">
                    <span>Orders to review (@pending)</span><span aria-hidden="true">→</span>
                </a>
                <a asp-area="Admin" asp-controller="Books" asp-action="Index" asp-route-lowStock="true">
                    <span>Low stock shelf (@lowStock)</span><span aria-hidden="true">→</span>
                </a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <span>Customers</span><span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

        <section>
            <div class="section-head"><h2 class="section-title-sm">Latest reviews</h2></div>

            @if (Model.RecentReviews.Count == 0)
            {
                <div class="empty-state empty-state--admin">
                    <span class="empty-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6a8.6 8.6 0 0 1-.9-3.9A8.4 8.4 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z" />
                        </svg>
                    </span>
                    <p>No reviews yet. Reader notes will land here.</p>
                </div>
            }
            else
            {
                <div class="card admin-reviews">
                    @foreach (var review in Model.RecentReviews)
                    {
                        <div class="admin-review">
                            <div class="review-top">
                                <span class="stars" aria-hidden="true">@(new string('★', review.Rating))</span>
                                <strong>@review.ReviewerName</strong>
                                <time>@review.CreatedAt.ToLocalTime().ToString("dd MMM")</time>
                            </div>
                            <p class="admin-review-book">@review.BookTitle</p>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p class="admin-review-comment">@review.Comment</p>
                            }
                        </div>
                    }
                </div>
            }
        </section>

        <section>
            <div class="section-head"><h2 class="section-title-sm">Low stock</h2></div>

            @if (lowStock == 0)
            {
                <div class="empty-state empty-state--admin">
                    <span class="empty-icon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 13 4 4L19 7" />
                        </svg>
                    </span>
                    <p>Every title is well stocked.</p>
                </div>
            }
            else
            {
                <div class="card">
                    @foreach (var book in Model.LowStockBooks)
                    {
                        <div class="summary-row">
                            <span><a asp-area="Admin" asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id">@book.Title</a></span>
                            <span class="badge badge-warning">@book.Stock left</span>
                        </div>
                    }
                </div>
            }
        </section>
    </aside>
</div>
